#!/usr/bin/env bash

set -euo pipefail

source_path=${BASH_SOURCE[0]}
while [[ -L $source_path ]]; do
  source_dir=$(cd "$(dirname "$source_path")" && pwd -P)
  source_path=$(readlink "$source_path")
  [[ $source_path == /* ]] || source_path="$source_dir/$source_path"
done
script_dir=$(cd "$(dirname "$source_path")" && pwd -P)

usage() {
  cat <<'EOF'
Usage: herdr-omarchy <hdl|hds|hdlm|hsl> [arguments]
       herdr-omarchy preset <name>
       hdl [ai-command] [second-ai-command]
       hds [agent-command]
       hdlm [options] [ai-command] [second-ai-command]
       hsl [pane-count] [command...]

Common options:
  --preset NAME       Apply a named preset from config.toml.

hdlm options:
  --dry-run           Show the tab plan without changing Herdr.
  --yes               Continue without prompting above the warning threshold.
  --exclude PATTERN   Exclude matching directory names; repeatable.
  --only PATTERN      Include only matching directory names; repeatable.

Layouts:
  hdl   Editor, bottom terminal, and right AI pane.
  hds   2x2 editor, diff, terminal, and agent layout.
  hdlm  One hdl tab per direct subdirectory.
  hsl   Tiled panes running the same command (default: 6 panes).

Environment:
  HERDR_OMARCHY_EDITOR                 Editor command (default: EDITOR or nvim)
  HERDR_OMARCHY_AI_COMMAND             AI command (default: opencode2)
  HERDR_OMARCHY_DIFF_COMMAND           hds diff command (default: hunk diff --watch)
  HERDR_OMARCHY_HDS_AGENT              hds agent command (default: AI command)
  HERDR_OMARCHY_EDITOR_TERMINAL_RATIO  Editor share above terminal (default: 0.85)
  HERDR_OMARCHY_EDITOR_AI_RATIO        Editor share left of AI pane (default: 0.70)
  HERDR_OMARCHY_AI_STACK_RATIO         First AI share above second AI (default: 0.50)
  HERDR_OMARCHY_SWARM_COUNT            Default hsl pane count (default: 6)
  HERDR_OMARCHY_SWARM_COMMAND          Default hsl command (default: AI command)
  HERDR_OMARCHY_CONFIG                 Config path override
EOF
}

fail() {
  printf 'herdr-omarchy: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "missing required command: $1"
}

shell_quote() {
  local value=${1-}
  printf "'%s'" "${value//\'/\'\\\'\'}"
}

in_cwd() {
  printf 'cd %s && %s' "$(shell_quote "$1")" "$2"
}

herdr_bin=${HERDR_BIN_PATH:-}
if [[ -z $herdr_bin ]]; then
  herdr_bin=$(command -v herdr || true)
fi
[[ -n $herdr_bin ]] || fail "herdr is not on PATH and HERDR_BIN_PATH is unset"

herdr() {
  "$herdr_bin" "$@"
}

herdr_quiet() {
  "$herdr_bin" "$@" >/dev/null
}

json_pane_id() {
  jq -r '.result.pane.pane_id // .result.pane_id // empty'
}

json_tab_id() {
  jq -r '.result.tab.tab_id // .result.tab_id // empty'
}

editor_command() {
  printf '%s .' "${HERDR_OMARCHY_EDITOR:-${EDITOR:-$config_editor}}"
}

default_ai_command() {
  printf '%s' "${HERDR_OMARCHY_AI_COMMAND:-$config_ai}"
}

plugin_mode=false
[[ -n ${HERDR_PLUGIN_ID:-} ]] && plugin_mode=true

invocation_pane=${HERDR_PANE_ID:-}
workspace_id=
tab_id=
project_dir=
pane_json=
config_json=
config_editor=nvim
config_ai=opencode2
config_diff='hunk diff --watch'
config_hds_agent=
config_editor_terminal_ratio=0.85
config_editor_ai_ratio=0.70
config_ai_stack_ratio=0.50
config_hdlm_warn_threshold=5
config_hdlm_exclude=()
config_hdlm_only=()
preset_name=
preset_layout=
preset_commands=()
preset_command=
preset_count=

load_config() {
  local config_path value
  config_path=${HERDR_OMARCHY_CONFIG:-${HERDR_PLUGIN_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/herdr/plugins/config/herdr-omarchy}/config.toml}
  if [[ -n $preset_name ]]; then
    config_json=$(python3 "$script_dir/read-config.py" "$config_path" "$preset_name")
  else
    config_json=$(python3 "$script_dir/read-config.py" "$config_path")
  fi

  config_editor=$(jq -r '.editor' <<<"$config_json")
  config_ai=$(jq -r '.ai' <<<"$config_json")
  config_diff=$(jq -r '.diff' <<<"$config_json")
  config_hds_agent=$(jq -r '.hds_agent // empty' <<<"$config_json")
  config_editor_terminal_ratio=$(jq -r '.ratios.editor_terminal' <<<"$config_json")
  config_editor_ai_ratio=$(jq -r '.ratios.editor_ai' <<<"$config_json")
  config_ai_stack_ratio=$(jq -r '.ratios.ai_stack' <<<"$config_json")
  config_hdlm_warn_threshold=$(jq -r '.hdlm.warn_threshold' <<<"$config_json")
  config_hdlm_exclude=()
  while IFS= read -r value; do
    config_hdlm_exclude+=("$value")
  done < <(jq -r '.hdlm.exclude[]' <<<"$config_json")
  config_hdlm_only=()
  while IFS= read -r value; do
    config_hdlm_only+=("$value")
  done < <(jq -r '.hdlm.only[]' <<<"$config_json")

  if [[ -n $preset_name ]]; then
    preset_layout=$(jq -r '.selected_preset.layout' <<<"$config_json")
    preset_commands=()
    while IFS= read -r value; do
      preset_commands+=("$value")
    done < <(jq -r '.selected_preset.commands[]?' <<<"$config_json")
    preset_command=$(jq -r '.selected_preset.command // empty' <<<"$config_json")
    preset_count=$(jq -r '.selected_preset.count // empty' <<<"$config_json")
  fi
}

resolve_context() {
  local context_json=${HERDR_PLUGIN_CONTEXT_JSON:-{}}

  [[ ${HERDR_ENV:-} == 1 ]] || fail "run this as a Herdr plugin action or from inside a Herdr pane"
  [[ -n $invocation_pane ]] || fail "HERDR_PANE_ID is missing"

  if ! pane_json=$(herdr pane get "$invocation_pane"); then
    fail "pane $invocation_pane no longer exists; open a new shell in the current Herdr session"
  fi

  workspace_id=$(jq -r '.result.pane.workspace_id // .result.workspace_id // empty' <<<"$pane_json")
  tab_id=$(jq -r '.result.pane.tab_id // .result.tab_id // empty' <<<"$pane_json")
  [[ -n $workspace_id ]] || fail "could not resolve the workspace for pane $invocation_pane"
  [[ -n $tab_id ]] || fail "could not resolve the tab for pane $invocation_pane"

  if [[ $plugin_mode == true ]]; then
    project_dir=$(jq -r '
      .result.pane.foreground_cwd //
      .result.pane.cwd //
      .result.foreground_cwd //
      .result.cwd //
      empty
    ' <<<"$pane_json")
    if [[ -z $project_dir ]]; then
      project_dir=$(jq -r '.focused_pane_cwd // .workspace_cwd // empty' <<<"$context_json")
    fi
  else
    project_dir=$(pwd -P)
  fi

  [[ -n $project_dir && -d $project_dir ]] || fail "could not resolve a valid working directory"
  project_dir=$(cd "$project_dir" && pwd -P)
}

lock_dir=

release_lock() {
  [[ -z $lock_dir ]] || rm -rf "$lock_dir"
}

acquire_tab_lock() {
  local lock_root lock_scope holder=
  lock_root=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/herdr-omarchy-$UID
  mkdir -p "$lock_root"
  chmod 0700 "$lock_root"
  lock_scope=$(printf '%s' "${HERDR_SOCKET_PATH:-default}" | cksum)
  lock_scope=${lock_scope%% *}
  lock_dir="$lock_root/$lock_scope-${tab_id//[^[:alnum:]_.-]/_}.lock"

  if ! mkdir "$lock_dir" 2>/dev/null; then
    [[ ! -f $lock_dir/pid ]] || holder=$(<"$lock_dir/pid")
    if [[ $holder =~ ^[0-9]+$ ]] && kill -0 "$holder" 2>/dev/null; then
      fail "another layout command is already running for tab $tab_id"
    fi
    rm -rf "$lock_dir"
    mkdir "$lock_dir" 2>/dev/null || fail "could not lock tab $tab_id"
  fi

  printf '%s' "$$" >"$lock_dir/pid"
  trap release_lock EXIT
}

tab_pane_count() {
  local target_tab=$1 tab_json count
  tab_json=$(herdr tab get "$target_tab")
  count=$(jq -r '.result.tab.pane_count // .result.pane_count // 0' <<<"$tab_json")
  [[ $count =~ ^[0-9]+$ ]] || count=0
  printf '%s' "$count"
}

require_empty_layout() {
  local count
  count=$(tab_pane_count "$tab_id")
  [[ $count == 1 ]] || fail "tab $tab_id already has $count panes; run this layout from a tab with one shell pane"
}

split_pane() {
  local target=$1 direction=$2 cwd=$3 ratio=$4 response pane_id
  response=$(herdr pane split "$target" --direction "$direction" --cwd "$cwd" --ratio "$ratio" --no-focus)
  pane_id=$(json_pane_id <<<"$response")
  [[ -n $pane_id ]] || fail "Herdr did not return a pane id after splitting $target $direction"
  printf '%s' "$pane_id"
}

rename_pane() {
  herdr_quiet pane rename "$1" "$2"
}

rename_tab() {
  herdr_quiet tab rename "$1" "$2"
}

wait_for_shell() {
  local pane_id=$1 process_json attempt
  for ((attempt = 0; attempt < 100; attempt++)); do
    if process_json=$(herdr pane process-info --pane "$pane_id" 2>/dev/null) &&
      jq -e '
        .result.process_info as $process |
        ($process.shell_pid != null) and
        ($process.foreground_processes | length == 1) and
        ($process.foreground_processes[0].pid == $process.shell_pid)
      ' >/dev/null <<<"$process_json"; then
      return
    fi
    sleep 0.05
  done
  fail "pane $pane_id did not become ready for a startup command"
}

run_in_pane() {
  local pane_id=$1 cwd=$2 command_text=${3:-}
  [[ -n $command_text ]] || return 0
  wait_for_shell "$pane_id"
  herdr_quiet pane run "$pane_id" "$(in_cwd "$cwd" "$command_text")"
}

require_source_shell() {
  [[ $plugin_mode == false ]] || wait_for_shell "$invocation_pane"
}

deferred_cwd=
deferred_command=

run_or_defer_in_source_pane() {
  local pane_id=$1 cwd=$2 command_text=$3
  if [[ $plugin_mode == false && $pane_id == "$invocation_pane" ]]; then
    deferred_cwd=$cwd
    deferred_command=$command_text
  else
    run_in_pane "$pane_id" "$cwd" "$command_text"
  fi
}

bootstrap_hdl() {
  local dir=$1 editor_pane=$2 ai_command=$3 second_ai_command=${4:-}
  local terminal_pane ai_pane ai2_pane

  terminal_pane=$(split_pane "$editor_pane" down "$dir" "${HERDR_OMARCHY_EDITOR_TERMINAL_RATIO:-$config_editor_terminal_ratio}")
  ai_pane=$(split_pane "$editor_pane" right "$dir" "${HERDR_OMARCHY_EDITOR_AI_RATIO:-$config_editor_ai_ratio}")

  rename_pane "$editor_pane" editor
  rename_pane "$terminal_pane" terminal
  rename_pane "$ai_pane" ai

  if [[ -n $second_ai_command ]]; then
    ai2_pane=$(split_pane "$ai_pane" down "$dir" "${HERDR_OMARCHY_AI_STACK_RATIO:-$config_ai_stack_ratio}")
    rename_pane "$ai2_pane" ai-2
    run_in_pane "$ai2_pane" "$dir" "$second_ai_command"
  fi

  run_in_pane "$ai_pane" "$dir" "$ai_command"
  run_or_defer_in_source_pane "$editor_pane" "$dir" "$(editor_command)"
}

layout_hdl() {
  local ai_command second_ai_command
  (( $# <= 2 )) || fail "hdl expects at most two command strings"
  require_source_shell
  require_empty_layout

  if (( $# == 0 && ${#preset_commands[@]} > 0 )); then
    ai_command=${preset_commands[0]}
    second_ai_command=${preset_commands[1]:-}
  else
    ai_command=${1:-$(default_ai_command)}
    second_ai_command=${2:-}
  fi
  bootstrap_hdl "$project_dir" "$invocation_pane" "$ai_command" "$second_ai_command"
  printf 'created hdl layout in %s\n' "$project_dir"
}

layout_hds() {
  local editor_pane=$invocation_pane terminal_pane diff_pane agent_pane diff_command agent_command
  (( $# <= 1 )) || fail "hds expects at most one agent command"
  require_source_shell
  require_empty_layout

  terminal_pane=$(split_pane "$editor_pane" down "$project_dir" 0.50)
  diff_pane=$(split_pane "$editor_pane" right "$project_dir" 0.50)
  agent_pane=$(split_pane "$terminal_pane" right "$project_dir" 0.50)
  diff_command=${HERDR_OMARCHY_DIFF_COMMAND:-$config_diff}
  if (( $# == 0 && ${#preset_commands[@]} > 0 )); then
    agent_command=${preset_commands[0]}
  else
    agent_command=${1:-${HERDR_OMARCHY_HDS_AGENT:-${config_hds_agent:-$(default_ai_command)}}}
  fi

  rename_pane "$editor_pane" editor
  rename_pane "$terminal_pane" terminal
  rename_pane "$diff_pane" diff
  rename_pane "$agent_pane" agent
  run_in_pane "$diff_pane" "$project_dir" "$diff_command"
  run_in_pane "$agent_pane" "$project_dir" "$agent_command"
  run_or_defer_in_source_pane "$editor_pane" "$project_dir" "$(editor_command)"
  printf 'created hds layout in %s\n' "$project_dir"
}

find_tab_id() {
  herdr tab list --workspace "$workspace_id" | jq -r --arg label "$1" '
    first(.result.tabs[]? | select(.label == $label) | .tab_id) // empty
  '
}

create_tab() {
  local dir=$1 label=$2 response created_tab root_pane
  response=$(herdr tab create --workspace "$workspace_id" --cwd "$dir" --label "$label" --no-focus)
  created_tab=$(json_tab_id <<<"$response")
  root_pane=$(jq -r '.result.root_pane.pane_id // empty' <<<"$response")
  [[ -n $created_tab && -n $root_pane ]] || fail "Herdr did not return a tab and root pane for $label"
  printf '%s\t%s' "$created_tab" "$root_pane"
}

matches_any_pattern() {
  local value=$1 pattern
  shift
  for pattern in "$@"; do
    [[ $value == $pattern ]] && return 0
  done
  return 1
}

print_hdlm_plan() {
  local index dir label existing
  printf 'hdlm will prepare %d folders in workspace %s:\n' "${#hdlm_dirs[@]}" "$workspace_id" >&2
  for ((index = 0; index < ${#hdlm_dirs[@]}; index++)); do
    dir=${hdlm_dirs[$index]}
    label=$(basename "$dir")
    if (( index == 0 )); then
      printf '  current tab %s <- %s\n' "$tab_id" "$label" >&2
      continue
    fi
    existing=$(find_tab_id "$label")
    if [[ -n $existing ]]; then
      printf '  existing tab %s <- %s\n' "$existing" "$label" >&2
    else
      printf '  new tab <- %s\n' "$label" >&2
    fi
  done
}

hdlm_dirs=()

layout_hdlm() {
  local ai_command second_ai_command first=true dry_run=false assume_yes=false
  local dir label existing existing_count created root_pane count=0 answer
  local -a commands=() exclude_patterns=("${config_hdlm_exclude[@]}") only_patterns=("${config_hdlm_only[@]}")

  while (( $# > 0 )); do
    case $1 in
      --dry-run)
        dry_run=true
        shift
        ;;
      --yes)
        assume_yes=true
        shift
        ;;
      --exclude|--only)
        [[ -n ${2:-} ]] || fail "$1 requires a pattern"
        if [[ $1 == --exclude ]]; then
          exclude_patterns+=("$2")
        else
          only_patterns+=("$2")
        fi
        shift 2
        ;;
      --)
        shift
        commands+=("$@")
        break
        ;;
      -*)
        fail "unknown hdlm option: $1"
        ;;
      *)
        commands+=("$1")
        shift
        ;;
    esac
  done

  (( ${#commands[@]} <= 2 )) || fail "hdlm expects at most two command strings"
  require_source_shell
  require_empty_layout

  if (( ${#commands[@]} == 0 && ${#preset_commands[@]} > 0 )); then
    ai_command=${preset_commands[0]}
    second_ai_command=${preset_commands[1]:-}
  else
    ai_command=${commands[0]:-$(default_ai_command)}
    second_ai_command=${commands[1]:-}
  fi

  hdlm_dirs=()
  shopt -s nullglob
  for dir in "$project_dir"/*/; do
    [[ -d $dir ]] || continue
    dir=${dir%/}
    label=$(basename "$dir")
    if (( ${#only_patterns[@]} > 0 )) && ! matches_any_pattern "$label" "${only_patterns[@]}"; then
      continue
    fi
    if (( ${#exclude_patterns[@]} > 0 )) && matches_any_pattern "$label" "${exclude_patterns[@]}"; then
      continue
    fi
    hdlm_dirs+=("$dir")
  done

  (( ${#hdlm_dirs[@]} > 0 )) || fail "no matching direct subdirectories under $project_dir"

  if [[ $dry_run == true ]] || (( config_hdlm_warn_threshold > 0 && ${#hdlm_dirs[@]} > config_hdlm_warn_threshold )); then
    print_hdlm_plan
  fi
  if [[ $dry_run == true ]]; then
    return
  fi
  if (( config_hdlm_warn_threshold > 0 && ${#hdlm_dirs[@]} > config_hdlm_warn_threshold )); then
    printf 'warning: this will prepare %d folder layouts and add up to %d tabs\n' \
      "${#hdlm_dirs[@]}" "$(( ${#hdlm_dirs[@]} - 1 ))" >&2
    if [[ $assume_yes != true ]]; then
      if [[ $plugin_mode == true ]]; then
        herdr_quiet notification show "hdlm needs confirmation" \
          --body "${#hdlm_dirs[@]} folders; run hdlm --yes from the current shell" || true
        fail "confirmation required for ${#hdlm_dirs[@]} folders; run hdlm --yes"
      fi
      [[ -t 0 ]] || fail "confirmation required for ${#hdlm_dirs[@]} folders; rerun with --yes"
      read -r -p 'Continue? [y/N] ' answer
      [[ $answer == y || $answer == Y || $answer == yes || $answer == YES ]] || fail "cancelled"
    fi
  fi

  for dir in "${hdlm_dirs[@]}"; do
    label=$(basename "$dir")
    if [[ $first == true ]]; then
      rename_tab "$tab_id" "$label"
      bootstrap_hdl "$dir" "$invocation_pane" "$ai_command" "$second_ai_command"
      first=false
      printf 'created hdlm tab %s\n' "$label"
      count=$((count + 1))
      continue
    fi

    existing=$(find_tab_id "$label")

    if [[ -n $existing ]]; then
      existing_count=$(tab_pane_count "$existing")
      if [[ $existing_count == 1 ]]; then
        root_pane=$(herdr pane list --workspace "$workspace_id" | jq -r --arg tab "$existing" '
          first(.result.panes[]? | select(.tab_id == $tab) | .pane_id) // empty
        ')
        [[ -n $root_pane ]] || fail "could not find the root pane for tab $existing"
        bootstrap_hdl "$dir" "$root_pane" "$ai_command" "$second_ai_command"
      fi
      printf 'kept hdlm tab %s\n' "$label"
      count=$((count + 1))
      continue
    fi

    created=$(create_tab "$dir" "$label")
    IFS=$'\t' read -r _ root_pane <<<"$created"
    bootstrap_hdl "$dir" "$root_pane" "$ai_command" "$second_ai_command"

    printf 'created hdlm tab %s\n' "$label"
    count=$((count + 1))
  done

  printf 'prepared hdlm layout for %s (%d tabs)\n' "$project_dir" "$count"
}

swarm_panes=()

split_swarm_group() {
  local pane_id=$1 count=$2 direction=$3
  local first_count second_count ratio new_pane next_direction
  if (( count <= 1 )); then
    swarm_panes+=("$pane_id")
    return
  fi

  first_count=$(((count + 1) / 2))
  second_count=$((count - first_count))
  ratio=$(awk -v first="$first_count" -v total="$count" 'BEGIN { printf "%.6f", first / total }')
  new_pane=$(split_pane "$pane_id" "$direction" "$project_dir" "$ratio")
  [[ $direction == right ]] && next_direction=down || next_direction=right
  split_swarm_group "$pane_id" "$first_count" "$next_direction"
  split_swarm_group "$new_pane" "$second_count" "$next_direction"
}

layout_hsl() {
  local count command_text index=1 pane_id
  require_command awk
  require_source_shell
  require_empty_layout

  if (( $# == 0 )); then
    count=${preset_count:-${HERDR_OMARCHY_SWARM_COUNT:-6}}
    command_text=${preset_command:-${HERDR_OMARCHY_SWARM_COMMAND:-$(default_ai_command)}}
  else
    count=$1
    shift
    command_text=${*:-${preset_command:-${HERDR_OMARCHY_SWARM_COMMAND:-$(default_ai_command)}}}
  fi
  [[ $count =~ ^[0-9]+$ ]] && (( count > 0 )) || fail "hsl pane count must be a positive integer"

  swarm_panes=()
  split_swarm_group "$invocation_pane" "$count" right
  for pane_id in "${swarm_panes[@]}"; do
    rename_pane "$pane_id" "swarm-$index"
    run_or_defer_in_source_pane "$pane_id" "$project_dir" "$command_text"
    index=$((index + 1))
  done
  printf 'created hsl layout in %s (%d panes)\n' "$project_dir" "$count"
}

main() {
  local program=${0##*/} command generic_preset=false parsing_options=true
  local -a filtered_args=()
  case $program in
    hdl|hds|hdlm|hsl)
      command=$program
      if [[ ${1:-} == -h || ${1:-} == --help || ${1:-} == help ]]; then
        usage
        return
      fi
      ;;
    *)
      command=${1:-}
      [[ -n $command ]] || { usage >&2; exit 1; }
      shift
      ;;
  esac

  if [[ $command == preset ]]; then
    preset_name=${1:-}
    [[ -n $preset_name ]] || fail "preset requires a name"
    shift
    generic_preset=true
  else
    while (( $# > 0 )); do
      if [[ $parsing_options == true && $1 == --preset ]]; then
        [[ -n ${2:-} ]] || fail "--preset requires a name"
        preset_name=$2
        shift 2
      elif [[ $parsing_options == true && $1 == -- ]]; then
        parsing_options=false
        filtered_args+=("$1")
        shift
      else
        filtered_args+=("$1")
        shift
      fi
    done
    set -- "${filtered_args[@]}"
  fi

  case $command in
    -h|--help|help)
      usage
      return
      ;;
    hdl|hds|hdlm|hsl|preset) ;;
    *) fail "unknown layout: $command" ;;
  esac

  require_command jq
  require_command python3
  load_config

  if [[ $generic_preset == true ]]; then
    command=$preset_layout
  elif [[ -n $preset_name && $preset_layout != "$command" ]]; then
    fail "preset $preset_name uses $preset_layout, not $command"
  fi

  resolve_context
  acquire_tab_lock
  "layout_$command" "$@"

  if [[ -n $deferred_command ]]; then
    release_lock
    trap - EXIT
    exec "${SHELL:-/bin/bash}" -lc "$(in_cwd "$deferred_cwd" "$deferred_command")"
  fi
}

main "$@"
