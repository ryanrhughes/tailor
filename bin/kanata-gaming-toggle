#!/bin/bash
# Toggle kanata homerow mods for gaming mode

# App name "omarchy-action" lets these toasts bypass do-not-disturb —
# without it, DND swallows the only feedback this toggle gives.
if systemctl --user is-active --quiet kanata.service; then
    systemctl --user stop kanata.service
    notify-send -a omarchy-action "Gaming Mode" "Homerow mods DISABLED" -i input-gaming
else
    systemctl --user start kanata.service
    notify-send -a omarchy-action "Gaming Mode" "Homerow mods ENABLED" -i input-keyboard
fi
